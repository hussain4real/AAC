APP_NAME=MAACC
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null

MAACC_ENTERPRISE_STATUS=non_enterprise
MAACC_ENTERPRISE_STATUS_MESSAGE="Enterprise onboarding and real sensitive-data onboarding are paused pending readiness approval."
MAACC_REGISTRATION_ENABLED=false
MAACC_TEAM_CREATION_ENABLED=false
MAACC_REAL_SENSITIVE_DATA_ENABLED=false
MAACC_READINESS_CHANGE_OWNER="Aminu Hussain"

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Agent runtime LLM router. `ai` (the default) calls approved providers through
# the Laravel AI SDK; `fake` swaps in a deterministic router for local/CI
# validation only, with no model spend. Never set this to `fake` in production —
# the app self-heals to `ai` there and logs a warning if it sees `fake`.
MAACC_LLM_DRIVER=ai

# Phase 2 enterprise runtime controls. Keep enterprise status and real sensitive
# data disabled until the external/WORM/scanner values are provisioned and the
# evidence gates in the readiness plan are signed.
MAACC_RUNTIME_POLICY_VERSION=1.0.0
MAACC_API_WEIGHT_BUDGET_PER_MINUTE=120
MAACC_API_RUN_CONCURRENCY=2
MAACC_API_CALLBACK_CONCURRENCY=4
MAACC_API_WRITE_CONCURRENCY=5
MAACC_API_READ_CONCURRENCY=10
MAACC_RUNTIME_STREAM_CONCURRENCY=5
MAACC_GATEWAY_MAX_BODY_KB=11264
MAACC_GATEWAY_MAX_HEADER_KB=16
MAACC_GATEWAY_REQUEST_TIMEOUT=150
MAACC_WEBHOOK_SIGNATURE_TOLERANCE=300
MAACC_WEBHOOK_SECRET_OVERLAP=86400
MAACC_WEBHOOK_RETENTION_DAYS=30
MAACC_APPROVAL_TTL_HOURS=168
MAACC_KNOWLEDGE_UPLOAD_MAX_KB=10240
MAACC_KNOWLEDGE_MAX_ARCHIVE_ENTRIES=500
MAACC_KNOWLEDGE_MAX_DECOMPRESSED_KB=51200
MAACC_KNOWLEDGE_MAX_COMPRESSION_RATIO=100
MAACC_KNOWLEDGE_MAX_PDF_PAGES=500
MAACC_KNOWLEDGE_MAX_TEXT_CHARACTERS=1000000
MAACC_KNOWLEDGE_MAX_CHUNKS=5000
MAACC_MALWARE_SCANNER_BINARY=
MAACC_AUDIT_CHAIN_KEY_ID=
MAACC_AUDIT_CHAIN_KEY=
MAACC_AUDIT_CHAIN_PREVIOUS_KEYS={}
MAACC_AUDIT_EXPORT_KEY_ID=
MAACC_AUDIT_EXPORT_KEY=
MAACC_AUDIT_EXPORT_PREVIOUS_KEYS={}
MAACC_AUDIT_ARCHIVE_DISK=audit_archive
MAACC_AUDIT_ARCHIVE_DRIVER=local
MAACC_AUDIT_ARCHIVE_IMMUTABLE_ENFORCED=false
MAACC_AUDIT_ARCHIVE_BUCKET=
MAACC_AUDIT_ARCHIVE_REGION=
MAACC_AUDIT_ARCHIVE_ACCESS_KEY=
MAACC_AUDIT_ARCHIVE_SECRET_KEY=
MAACC_AUDIT_ARCHIVE_RETENTION_DAYS=2555
