{
    "name": "maacc/sdk",
    "description": "Framework-agnostic PHP client for the MAACC SDK and runtime API: token exchange, manifest sync, implementation reporting, and pause/resume agent runs.",
    "type": "library",
    "version": "0.2.0",
    "license": "MIT",
    "keywords": [
        "maacc",
        "orchestration",
        "ai",
        "agent",
        "sdk"
    ],
    "require": {
        "php": ">=8.2",
        "ext-curl": "*",
        "ext-json": "*"
    },
    "autoload": {
        "psr-4": {
            "Maacc\\Sdk\\": "src/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
