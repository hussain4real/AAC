{
    "api_version": "1.0.0",
    "schema_validation": [
        {
            "name": "all base types valid",
            "schema": {
                "s": "string",
                "n": "number",
                "i": "integer",
                "b": "boolean",
                "o": "object",
                "a": "array"
            },
            "payload": {
                "s": "x",
                "n": 1.5,
                "i": 2,
                "b": true,
                "o": {
                    "k": "v"
                },
                "a": [
                    1,
                    2
                ]
            },
            "valid": true,
            "errors": []
        },
        {
            "name": "optional field omitted is valid",
            "schema": {
                "query": "string",
                "limit": "integer?"
            },
            "payload": {
                "query": "today"
            },
            "valid": true,
            "errors": []
        },
        {
            "name": "missing required field",
            "schema": {
                "query": "string",
                "total": "number"
            },
            "payload": {
                "total": 5
            },
            "valid": false,
            "errors": [
                "Missing required field \"query\"."
            ]
        },
        {
            "name": "wrong scalar type",
            "schema": {
                "n": "number"
            },
            "payload": {
                "n": "nope"
            },
            "valid": false,
            "errors": [
                "Field \"n\" must be of type number."
            ]
        },
        {
            "name": "integer rejects a float",
            "schema": {
                "i": "integer"
            },
            "payload": {
                "i": 1.5
            },
            "valid": false,
            "errors": [
                "Field \"i\" must be of type integer."
            ]
        },
        {
            "name": "boolean is not a number",
            "schema": {
                "n": "number"
            },
            "payload": {
                "n": true
            },
            "valid": false,
            "errors": [
                "Field \"n\" must be of type number."
            ]
        },
        {
            "name": "object rejects a list",
            "schema": {
                "o": "object"
            },
            "payload": {
                "o": [
                    1,
                    2
                ]
            },
            "valid": false,
            "errors": [
                "Field \"o\" must be of type object."
            ]
        },
        {
            "name": "array rejects an object",
            "schema": {
                "a": "array"
            },
            "payload": {
                "a": {
                    "k": "v"
                }
            },
            "valid": false,
            "errors": [
                "Field \"a\" must be of type array."
            ]
        },
        {
            "name": "date format is enforced",
            "schema": {
                "d": "string·date"
            },
            "payload": {
                "d": "2026-01-01"
            },
            "valid": true,
            "errors": []
        },
        {
            "name": "undeclared fields are rejected",
            "schema": {
                "query": "string"
            },
            "payload": {
                "query": "hi",
                "extra": true
            },
            "valid": false,
            "errors": [
                "Field \"extra\" is not declared by the schema."
            ]
        },
        {
            "name": "nested arrays enums formats and bounds are valid",
            "schema": {
                "request": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "email": {
                            "type": "string",
                            "format": "email",
                            "maxLength": 254
                        },
                        "priority": {
                            "type": "integer",
                            "minimum": 1,
                            "maximum": 5
                        },
                        "tags": {
                            "type": "array",
                            "maxItems": 3,
                            "items": {
                                "type": "string",
                                "enum": [
                                    "ops",
                                    "safety"
                                ]
                            }
                        }
                    }
                }
            },
            "payload": {
                "request": {
                    "email": "ops@example.com",
                    "priority": 3,
                    "tags": [
                        "ops"
                    ]
                }
            },
            "valid": true,
            "errors": []
        },
        {
            "name": "nested constraints and additional properties are rejected",
            "schema": {
                "request": {
                    "type": "object",
                    "properties": {
                        "priority": {
                            "type": "integer",
                            "minimum": 1,
                            "maximum": 5
                        },
                        "tags": {
                            "type": "array",
                            "maxItems": 1,
                            "items": {
                                "type": "string",
                                "enum": [
                                    "ops"
                                ]
                            }
                        }
                    }
                }
            },
            "payload": {
                "request": {
                    "priority": 9,
                    "tags": [
                        "ops",
                        "other"
                    ],
                    "admin": true
                }
            },
            "valid": false,
            "errors": [
                "Field \"request.priority\" exceeds maximum.",
                "Field \"request.tags\" exceeds maxItems.",
                "Field \"request.tags[1]\" must be one of the declared enum values.",
                "Field \"request.admin\" is not declared by the schema."
            ]
        }
    ],
