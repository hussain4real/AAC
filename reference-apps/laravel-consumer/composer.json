{
    "name": "maacc/laravel-consumer",
    "description": "Reference Laravel application that integrates with MAACC through the maacc/sdk client.",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.2",
        "illuminate/console": "^11.0 || ^12.0 || ^13.0",
        "illuminate/support": "^11.0 || ^12.0 || ^13.0",
        "maacc/sdk": "*"
    },
    "autoload": {
        "psr-4": {
            "Maacc\\Reference\\Laravel\\": "src/"
        }
    },
    "repositories": [
        {
            "type": "path",
            "url": "../../packages/maacc-sdk-php"
        }
    ],
    "extra": {
        "laravel": {
            "providers": [
                "Maacc\\Reference\\Laravel\\MaaccServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
