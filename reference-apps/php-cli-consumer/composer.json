{
    "name": "maacc/php-cli-consumer",
    "description": "Reference plain-PHP CLI application (no framework) that integrates with MAACC through maacc/sdk.",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.2",
        "maacc/sdk": "*"
    },
    "autoload": {
        "psr-4": {
            "Maacc\\Reference\\Cli\\": "src/"
        }
    },
    "repositories": [
        {
            "type": "path",
            "url": "../../packages/maacc-sdk-php"
        }
    ],
    "bin": [
        "bin/maacc-run"
    ],
    "minimum-stability": "stable",
    "prefer-stable": true
}
